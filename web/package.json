{
  "name": "@web/auto-efnol-without-login",
  "private": true,
  "version": "0.1.0",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "homepage": "",
  "scripts": {
    "build": "tsc && vite build",
    "build:snyk": "vite build --config vite.snyk.config.ts",
    "clean": "rimraf dist",
    "dev": "vite",
    "preview": "yarn build && vite preview",
    "start": "yarn dev",
    "test": "cross-env TZ=America/Los_Angeles CI=true vitest --reporter=verbose",
    "test:ci": "cross-env TZ=America/Los_Angeles REACT_APP_SOURCES=stubs CI=true vitest --silent",
    "test:coverage": "cross-env TZ=America/Los_Angeles CI=true vitest --silent --reporter dot --coverage",
    "test:dev": "cross-env TZ=America/Los_Angeles vitest --ui --allowOnly",
    "test:update": "cross-env TZ=America/Los_Angeles CI=true vitest -u --silent"
  },
  "dependencies": {
    "@ace-clublabs/ace-identity": "^10.0.21",
    "@ace-clublabs/iss-common-util": "^10.6.39",
    "@ace-clublabs/log-cannon": "^10.2.2",
    "@ace-clublabs/shared-component-library": "10.24.0",
    "@ace-clublabs/iss-common-auto-efnol-models": "^10.0.66",
    "@ace-clublabs/iss-common-shared-claims-models": "^10.0.11",
    "@ace-clublabs/feature-flags": "^1.1.17",
    "@lib/common-utils": "*",
    "@lib/shared-contracts": "*",
    "@lib/types": "*",
    "@lib/utility": "*",
    "axios": "1.19.0",
    "@vitejs/plugin-basic-ssl": "1.0.1",
    "jwt-decode": "4.0.0",
    "localforage": "1.10.0",
    "match-sorter": "6.3.1",
    "react-cookie": "^4.1.1",
    "react-dom": "^18.2.0",
    "react-hooks-global-state": "1.0.2",
    "react-router-dom": "6.8.1",
    "react": "^18.2.0",
    "sort-by": "1.2.0",
    "uuid": "^14.0.1"
  },
  "resolutions": {
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.22.4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react": "16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/react-dom": "^18.2.22",
    "@types/react": "^18.2.67",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-c8": "0.29.2",
    "@vitest/ui": "0.29.2",
    "cross-env": "7.0.3",
    "happy-dom": "^14.12.2",
    "rimraf": "3.0.0",
    "rollup-plugin-copy": "3.4.0",
    "typescript": "^5.9.3",
    "vite-plugin-environment": "^1.1.3",
    "vite-plugin-fonts": "0.7.0",
    "vite-plugin-node-polyfills": "^0.7.0",
    "vite": "4.1.0",
    "vitest": "0.29.2"
  }
}
