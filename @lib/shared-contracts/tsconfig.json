{
  "compilerOptions": {
    "baseUrl": ".",
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "lib": ["dom", "es2015"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "noImplicitAny": false,
    "outDir": "dist",
    "paths": {
      "*": ["node_modules/*", "src/*"]
    },
    "types": ["node"],
    "typeRoots": ["type-overrides", "node_modules/@types"],
    "resolveJsonModule": true,
    "sourceMap": true,
    "target": "es6",
    "skipLibCheck": true
  },
  "extends": "../../tsconfig.json"
}
